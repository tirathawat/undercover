{
  "name": "undercover-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n go,web \"go run ./cmd/undercover\" \"vite --host 0.0.0.0 --port 3017\"",
    "build": "tsc --noEmit && vite build",
    "start": "go run ./cmd/undercover",
    "test": "npm run test:client && npm run test:ui && npm run test:server",
    "test:client": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:server": "go test -race ./internal/... ./cmd/...",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && go vet ./internal/... ./cmd/...",
    "build:server": "go build -o bin/undercover ./cmd/undercover",
    "test:ui": "vitest run"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
